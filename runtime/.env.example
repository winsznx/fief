# Copy to .env. Every runtime script loads it automatically via
# `tsx --env-file-if-exists=.env`, so nothing needs exporting in your shell.
#
# .env is gitignored. Never commit a funded key.

# Mainnet operator. Needs OG for gas and a funded 0G Compute ledger for
# inference. Only the write paths use it: `campaign`, `epoch`, `adversarial`,
# `rental`, `settle`, `demo-reject`.
#
# `packages/verify` needs no key at all. That is the point of it: anyone can
# recheck the record with nothing but a public RPC.
PRIVATE_KEY=0x...

# mainnet (16661) or testnet (16602).
NETWORK=mainnet
