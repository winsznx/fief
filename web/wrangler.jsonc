{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "fief",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-08-01",
  // nodejs_compat is required by the OpenNext runtime shim.
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "observability": { "enabled": true },
  "vars": {
    "NEXT_PUBLIC_DATA_MODE": "live",
    "NEXT_PUBLIC_NETWORK": "mainnet",
    "NEXT_PUBLIC_RPC_URL": "https://evmrpc.0g.ai",
    "NEXT_PUBLIC_DEPLOY_BLOCK": "42582000",
    "NEXT_PUBLIC_RECORD_BOOK": "0x40eB003340f467e096F8Ae30f8696bE40Eba922c",
    "NEXT_PUBLIC_EPOCH_BOOK": "0x9f02bfBbc52fD91d1899C298B71AF1871CA45DF8",
    "NEXT_PUBLIC_FIEF_AGENT": "0x4db74faF047160893Aa0dabC9A1B8F3297570a68",
    "NEXT_PUBLIC_RENTAL_DESK": "0x75C6ce6c6Cc40c922B30F985e75580C32Cd78e57",
    "NEXT_PUBLIC_AGENT_ID": "8",
    "NEXT_PUBLIC_EPOCH_ID": "0",
    "NEXT_PUBLIC_GREEN_TX": "0xc8543dfc0a44adced1c35bce3b5f336feaba8e31ff658a81f2eab0bd249ade19",
    "NEXT_PUBLIC_RED_TX": "0x6d68ade363d72e788f01120684de7dd179624d7e5ff5258335b0741cb055a06b"
  }
}
